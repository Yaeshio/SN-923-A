# --- Database (Supabase) ---
# 本番: Transaction pooler (6543)。Dashboard > Connect > Transaction pooler の文字列をそのまま使う。
#   - ホストは aws-0 / aws-1 などプロジェクトごとに異なる。手で書かず、必ずコピーする。
#   - ユーザー名は postgres.<project-ref> の形式。パスワードの特殊文字は URL エンコードが必要。
#   - 手元で確認するなら supabase/.temp/pooler-url (supabase link 後) のホストが正。ポートだけ 6543 にする。
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres"
# ローカル (supabase start) の場合:
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase Public API ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Next.js / App Settings ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Monitoring / Audit (Optional) ---
# LOG_LEVEL="info"
