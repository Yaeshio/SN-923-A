# --- Database (Supabase) ---
# アプリ用: 専用ロール app_runtime (RLS をバイパスできない) で接続する。
# withUser (src/shared/db/rls.ts) を通さないクエリは permission denied になる。
# 本番: Transaction pooler (6543)。Dashboard > Connect > Transaction pooler の文字列をそのまま使う。
#   - ホストは aws-0 / aws-1 などプロジェクトごとに異なる。手で書かず、必ずコピーする。
#   - ユーザー名は app_runtime.<project-ref> の形式 (コピーした postgres.<project-ref> の postgres 部分を app_runtime に替える)。
#   - app_runtime のパスワードは migration に含まれない。ALTER ROLE app_runtime PASSWORD '...' で環境ごとに設定する (specs/08_deployment_supabase.md)。
#   - パスワードの特殊文字は URL エンコードが必要。
#   - 手元で確認するなら supabase/.temp/pooler-url (supabase link 後) のホストが正。ポートだけ 6543 にする。
DATABASE_URL="postgresql://app_runtime.<project-ref>:<password>@<pooler-host>.pooler.supabase.com:6543/postgres"
# ローカル (supabase start) の場合 (パスワードは README の手順で app_runtime に設定する):
# DATABASE_URL="postgresql://app_runtime:app_runtime@127.0.0.1:54322/postgres"

# 管理用: postgres ロール (RLS を受けない)。seed (npm run db:seed)・drizzle-kit・テストなど、アプリの外のスクリプトだけが使う。
# アプリの実行環境 (本番の Next.js / Vercel) には設定しない。設定すると、接続を分けた意味がなくなる。
# ローカル (supabase start) の場合:
DATABASE_ADMIN_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# --- Supabase Public API ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --- Next.js / App Settings ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Monitoring / Audit (Optional) ---
# LOG_LEVEL="info"
